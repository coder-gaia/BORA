FROM node:24.22.0-bookworm-slim AS build

WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM caddy:2.11.8-alpine@sha256:f6228111e5fafa1a5238258d0858e103f10599b8d1659a146e7726681a002bb9 AS assets

COPY --from=build /app/dist /app/dist
COPY infra/caddy/export-web.sh /usr/local/bin/bora-export-web
RUN chmod +x /usr/local/bin/bora-export-web

ENTRYPOINT ["/usr/local/bin/bora-export-web"]
CMD ["stage"]
