FROM node:24.22.0-bookworm-slim AS build

WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5 AS assets

COPY --from=build /app/dist /app/dist
COPY infra/caddy/export-web.sh /usr/local/bin/bora-export-web
RUN chmod +x /usr/local/bin/bora-export-web

ENTRYPOINT ["/usr/local/bin/bora-export-web"]
CMD ["stage"]
