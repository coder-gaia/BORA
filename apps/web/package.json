{
  "name": "@bora/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "contract:install": "npm ci --prefix tools/api-contract",
    "contract:generate": "node ../../scripts/generate-api-types.mjs",
    "contract:check": "node ../../scripts/generate-api-types.mjs --check",
    "test:e2e": "playwright test",
    "test:map-performance": "node scripts/measure-map.mjs",
    "test:unit": "node --test unit/order-progress.test.ts unit/courier-motion.test.ts unit/public-map-feed.test.mjs unit/preview-projection.test.mjs unit/courier-canvas.test.mjs unit/basemap-integrity.test.mjs unit/viewport-gate.test.mjs unit/tracking-protocol.test.ts unit/route-motion.test.ts unit/auto-drive.test.ts unit/training-intent.test.ts unit/courier-work.test.ts unit/operations-clock.test.ts unit/operations-map-feed.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-slot": "1.5.0",
    "@stomp/stompjs": "7.5.0",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
