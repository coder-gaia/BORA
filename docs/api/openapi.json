{
  "components": {
    "schemas": {
      "ApiProblem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["field", "message"],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "format": "uri",
            "type": "string"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": ["code", "detail", "status", "title", "type"],
        "type": "object"
      },
      "CancelOrderRequest": {
        "properties": {
          "expectedVersion": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": ["expectedVersion"],
        "type": "object"
      },
      "CreateOrderRequest": {
        "properties": {
          "dropoff": {
            "$ref": "#/components/schemas/DropoffRequest"
          }
        },
        "required": ["dropoff"],
        "type": "object"
      },
      "CsrfView": {
        "properties": {
          "headerName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": ["headerName", "token"],
        "type": "object"
      },
      "DemoLogin": {
        "properties": {
          "role": {
            "enum": ["COURIER", "OPERATIONS", "STORE"],
            "type": "string"
          }
        },
        "required": ["role"],
        "type": "object"
      },
      "DemoUserView": {
        "properties": {
          "courierId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "displayName": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": ["COURIER", "OPERATIONS", "STORE"],
            "type": "string"
          },
          "storeId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["displayName", "expiresAt", "id", "role"],
        "type": "object"
      },
      "DropoffRequest": {
        "properties": {
          "latitude": {
            "format": "double",
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "longitude": {
            "format": "double",
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          }
        },
        "required": ["latitude", "longitude"],
        "type": "object"
      },
      "GeoPoint": {
        "properties": {
          "latitude": {
            "format": "double",
            "type": "number"
          },
          "longitude": {
            "format": "double",
            "type": "number"
          }
        },
        "required": ["latitude", "longitude"],
        "type": "object"
      },
      "OrderEventView": {
        "properties": {
          "fromStatus": {
            "anyOf": [
              {
                "enum": ["ASSIGNED", "AT_STORE", "CANCELED", "DELIVERED", "PICKED_UP", "SEARCHING"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "orderVersion": {
            "format": "int64",
            "type": "integer"
          },
          "toStatus": {
            "enum": ["ASSIGNED", "AT_STORE", "CANCELED", "DELIVERED", "PICKED_UP", "SEARCHING"],
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": ["id", "occurredAt", "orderVersion", "toStatus", "type"],
        "type": "object"
      },
      "OrderPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderSummary"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": ["items", "page", "size", "totalElements", "totalPages"],
        "type": "object"
      },
      "OrderSummary": {
        "properties": {
          "courierId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "dropoff": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "publicCode": {
            "type": "string"
          },
          "slaDeadline": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": ["ASSIGNED", "AT_STORE", "CANCELED", "DELIVERED", "PICKED_UP", "SEARCHING"],
            "type": "string"
          },
          "store": {
            "$ref": "#/components/schemas/StoreView"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "createdAt",
          "dropoff",
          "id",
          "publicCode",
          "slaDeadline",
          "status",
          "store",
          "version"
        ],
        "type": "object"
      },
      "OrderView": {
        "properties": {
          "confirmationCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "courierId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "dropoff": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "publicCode": {
            "type": "string"
          },
          "slaDeadline": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "enum": ["ASSIGNED", "AT_STORE", "CANCELED", "DELIVERED", "PICKED_UP", "SEARCHING"],
            "type": "string"
          },
          "store": {
            "$ref": "#/components/schemas/StoreView"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/OrderEventView"
            },
            "type": "array"
          },
          "version": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "createdAt",
          "dropoff",
          "id",
          "publicCode",
          "slaDeadline",
          "status",
          "store",
          "timeline",
          "version"
        ],
        "type": "object"
      },
      "SessionView": {
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DemoUserView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["authenticated", "user"],
        "type": "object"
      },
      "StoreView": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "name": {
            "type": "string"
          },
          "serviceAreaId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["id", "location", "name", "serviceAreaId"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "csrfToken": {
        "description": "Token devolvido por GET /api/v1/auth/csrf, vinculado ao cookie da mesma sessão. Obtenha outro após entrar, trocar de papel ou sair.",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "type": "apiKey"
      },
      "sessionCookie": {
        "description": "Cookie HttpOnly da sessão, enviado pelo navegador. Obter CSRF cria uma sessão anônima; entrar na demonstração autentica essa sessão.",
        "in": "cookie",
        "name": "BORA_SESSION",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Demonstração de despacho de entregas em São Paulo.",
    "title": "Bora API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "getCsrf",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfView"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [],
        "summary": "Obter a proteção CSRF da sessão",
        "tags": ["demo-auth-controller"]
      }
    },
    "/api/v1/auth/demo": {
      "post": {
        "operationId": "enterDemo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Confira o papel informado."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O token CSRF ou o papel não permite esta ação."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Limite de entradas atingido.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até uma nova tentativa, quando o bloqueio tem prazo conhecido.",
                "required": false,
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": []
          }
        ],
        "summary": "Entrar na demonstração ou trocar de papel",
        "tags": ["demo-auth-controller"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logoutDemo",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O token CSRF ou o papel não permite esta ação."
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": []
          }
        ],
        "summary": "Sair da demonstração e encerrar o contexto visitante",
        "tags": ["demo-auth-controller"]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [],
        "summary": "Consultar a sessão atual",
        "tags": ["demo-auth-controller"]
      }
    },
    "/api/v1/orders": {
      "get": {
        "description": "Mostra pedidos do contexto do visitante e pedidos públicos das lojas simuladas.",
        "operationId": "listOrders",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Confira os parâmetros de paginação."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Entre na demonstração para continuar."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O papel ou a sessão não permite esta ação."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Listar pedidos visíveis",
        "tags": ["orders-controller"]
      },
      "post": {
        "description": "Cria um pedido da loja autenticada. A mesma chave e o mesmo destino repetem a resposta original.",
        "operationId": "createOrder",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            },
            "description": "Pedido criado ou repetido pela chave de idempotência."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Confira o destino e a chave de idempotência."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Entre na demonstração para continuar."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O token CSRF ou o papel não permite esta ação."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "A chave de idempotência já foi usada para outro destino."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O destino fica fora da área atendida ou não possui rota de moto."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Limite de criação ou de pedidos ativos atingido.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até uma nova tentativa, quando o bloqueio tem prazo conhecido.",
                "required": false,
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O grafo de roteamento ainda não está disponível."
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": []
          }
        ],
        "summary": "Criar um pedido de entrega",
        "tags": ["orders-controller"]
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Entre na demonstração para continuar."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O papel ou a sessão não permite esta ação."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O recurso não existe ou não está visível neste contexto."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Consultar um pedido e sua linha do tempo",
        "tags": ["orders-controller"]
      }
    },
    "/api/v1/orders/{id}/cancel": {
      "post": {
        "description": "Exige a versão atual e respeita o papel, a propriedade e a etapa do pedido.",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrderView"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Confira o pedido e sua versão."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Entre na demonstração para continuar."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O token CSRF ou o papel não permite esta ação."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O pedido não existe ou não está visível neste contexto."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "A versão ou a etapa do pedido mudou. Consulte o pedido novamente."
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": []
          }
        ],
        "summary": "Cancelar um pedido",
        "tags": ["orders-controller"]
      }
    },
    "/api/v1/stores/me": {
      "get": {
        "operationId": "getCurrentStore",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StoreView"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "Entre na demonstração para continuar."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O papel ou a sessão não permite esta ação."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            },
            "description": "O recurso não existe ou não está visível neste contexto."
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "summary": "Consultar a loja autenticada",
        "tags": ["stores-controller"]
      }
    }
  }
}
