{
	admin localhost:2019
	email {$ACME_EMAIL}
	grace_period 45s
}

{$SITE_ADDRESS} {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:"
	}

	@api path /api /api/* /ws /ws/* /actuator/health /actuator/health/readiness /actuator/health/liveness
	handle @api {
		reverse_proxy {$API_UPSTREAMS:api1:8080 api2:8080} {
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 100ms
			health_uri /actuator/health/readiness
			health_status 200
			health_interval 1s
			health_timeout 2s
			health_passes 1
			health_fails 1
			fail_duration 5s
			max_fails 1
			transport http {
				dial_timeout 2s
				response_header_timeout 30s
			}
		}
	}

	@private path /actuator /actuator/*
	handle @private {
		respond 404
	}

	handle /assets/* {
		root * /srv/bora
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/bora/current
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
