{
	admin localhost:2019
	email {$ACME_EMAIL}
	grace_period 45s
}

(api_proxy) {
	reverse_proxy {args[:]} {
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 100ms
		health_uri /actuator/health/readiness
		health_status 200
		health_interval 1s
		health_timeout 2s
		health_passes 1
		health_fails 1
		fail_duration 5s
		max_fails 1
		transport http {
			dial_timeout 2s
			response_header_timeout 30s
		}
	}
}

{$SITE_ADDRESS} {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	vars content_security_policy {file./etc/caddy/content-security-policy}
	map {http.vars.content_security_policy} {security_policy} {
		"" "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
		default {http.vars.content_security_policy}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "{security_policy}"
	}

	@simulator_internal path /api/v1/simulator /api/v1/simulator/* /api/v1/auth/simulator
	handle @simulator_internal {
		respond 404
	}

	@api path /api /api/* /ws /ws/* /actuator/health /actuator/health/readiness /actuator/health/liveness
	handle @api {
		vars upstream_mode {file./etc/caddy/upstream-mode}
		@mode_api1 vars upstream_mode api1
		@mode_api2 vars upstream_mode api2
		@mode_both vars upstream_mode both

		handle @mode_api1 {
			import api_proxy api1:8080
		}
		handle @mode_api2 {
			import api_proxy api2:8080
		}
		handle @mode_both {
			import api_proxy api1:8080 api2:8080
		}
		handle {
			respond 503
		}
	}

	@private path /actuator /actuator/*
	handle @private {
		respond 404
	}

	handle /assets/* {
		root * /srv/bora
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/bora/current
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
